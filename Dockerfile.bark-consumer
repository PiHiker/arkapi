FROM rustlang/rust:nightly AS builder

ARG BARK_COMMIT=4962bd70f568dedc30e622406a97067d4c43f800

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        git \
        libsqlite3-dev \
        libssl-dev \
        pkg-config \
        protobuf-compiler && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src

RUN git clone https://gitlab.com/ark-bitcoin/bark.git . && \
    git checkout "${BARK_COMMIT}" && \
    cargo build --release --bin bark

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        netbase && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/bark /usr/local/bin/bark

COPY scripts/bark-consumer-init.sh /usr/local/bin/bark-consumer-init.sh
RUN chmod +x /usr/local/bin/bark-consumer-init.sh

VOLUME /root/.bark

ENTRYPOINT ["/usr/local/bin/bark-consumer-init.sh"]
