FROM rustlang/rust:nightly AS builder

ARG BARK_COMMIT=e1cadf3812d809eaa52c1af085641de95e827080

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        clang \
        cmake \
        git \
        libsqlite3-dev \
        libssl-dev \
        pkg-config \
        protobuf-compiler && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Build Bark from a pinned upstream release commit for deterministic rebuilds.
RUN git clone https://gitlab.com/ark-bitcoin/bark.git . && \
    git checkout "${BARK_COMMIT}" && \
    cargo build --release --bin bark --bin barkd

FROM debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        netbase && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/target/release/bark /usr/local/bin/bark
COPY --from=builder /src/target/release/barkd /usr/local/bin/barkd

COPY scripts/bark-init.sh /usr/local/bin/bark-init.sh
RUN chmod +x /usr/local/bin/bark-init.sh

VOLUME /root/.bark

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/bark-init.sh"]
